# Production-like env for local `expo start` / config tests.
# EAS cloud builds: set the same keys in Expo → Project → Environment variables
# (production), or they are merged with eas.json `production.env` (API URL + APP_ENV).

EXPO_PUBLIC_APP_ENV=production

# Must end with /api (same as resolveBackendRestApiUrl).
EXPO_PUBLIC_API_BASE_URL=https://build-profit-solutions-backend.onrender.com/api

# Clerk: use pk_live_… for App Store / Play production; pk_test_… only for internal test builds.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Stripe Checkout in the app: match mode to Render STRIPE_SECRET_KEY (test vs live).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional PDF export host (defaults to api base if unset in app).
# EXPO_PUBLIC_PDF_API_BASE_URL=https://build-profit-solutions-backend.onrender.com/api

# Beta feedback row in Profile (optional).
# EXPO_PUBLIC_BETA_FEEDBACK_ENABLED=true
# EXPO_PUBLIC_BETA_FEEDBACK_ALLOWLIST_EMAILS=

# Do not set LAN URLs here for store builds.

# Yelp area search in Find Subcontractors (off until you add YELP_API_KEY on the backend + a Yelp plan).
# EXPO_PUBLIC_YELP_SUB_SEARCH_ENABLED=true
