{
  "name": "build-profit-solutions-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_DOCTOR=1 npx expo start --tunnel",
    "start:lan": "EXPO_NO_DOCTOR=1 bash -c 'source scripts/lan-packager-host-env.sh && npx expo start --lan'",
    "start:go": "EXPO_NO_DOCTOR=1 npx expo start --tunnel --clear --go",
    "start:sim": "EXPO_NO_DOCTOR=1 npx expo start --localhost --clear --ios",
    "start:offline": "EXPO_NO_DOCTOR=1 npx expo start --offline --clear",
    "start:dev": "EXPO_NO_DOCTOR=1 npx expo start --dev-client",
    "start:dev:lan": "EXPO_NO_DOCTOR=1 bash -c 'source scripts/lan-packager-host-env.sh && npx expo start --dev-client --lan'",
    "start:dev:lan:web": "EXPO_NO_DOCTOR=1 bash -c 'source scripts/lan-packager-host-env.sh && npx expo start --dev-client --lan --web'",
    "start:dev:tunnel": "EXPO_NO_DOCTOR=1 npx expo start --dev-client --tunnel --clear",
    "start:dev:tunnel:web": "EXPO_NO_DOCTOR=1 npx expo start --dev-client --tunnel --web --clear",
    "build:dev:ios": "EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development --platform ios",
    "build:dev:android": "EXPO_NO_CAPABILITY_SYNC=1 eas build --profile development --platform android",
    "submit:ios:production": "EXPO_PUBLIC_APP_ENV=production npx eas-cli submit --platform ios --profile production --latest",
    "dev": "EXPO_NO_DOCTOR=1 npx expo start --dev-client --tunnel",
    "dev:lan": "bash start-lan.sh",
    "dev:clear": "pkill -f 'expo start' 2>/dev/null || true; sleep 1; EXPO_NO_DOCTOR=1 npx expo start --dev-client --tunnel --clear",
    "dev:web": "EXPO_NO_DOCTOR=1 npx expo start --web",
    "dev:tunnel": "pkill -f 'expo start' 2>/dev/null || true; sleep 1; EXPO_NO_DOCTOR=1 npx expo start --dev-client --tunnel --clear",
    "dev:reset": "pkill -f 'expo start' 2>/dev/null || true; rm -rf .expo .expo-shared node_modules/.cache .metro-cache 2>/dev/null || true; sleep 1; EXPO_NO_DOCTOR=1 npx expo start --dev-client --tunnel --clear",
    "clear": "./clear-cache.sh",
    "check:hot-reload": "node scripts/check-hot-reload.js",
    "reload": "node scripts/force-reload.js",
    "lint": "eslint app/_layout.tsx \"app/(tabs)/_layout.tsx\" \"app/(tabs)/dashboard.tsx\" \"app/(tabs)/projects.tsx\" \"app/(tabs)/assistant.tsx\" \"app/project-detail/[id].tsx\" app/auth.tsx \"app/auth/**/*.tsx\" app/onboarding.tsx components/AIAssistantModal.tsx components/ProjectCalendar.tsx components/BudgetActions.tsx components/BudgetProfitMixCard.tsx components/BudgetTab.tsx components/AddMaterialScreen.tsx components/AddTransactionModal.tsx components/AddPurchaseOrderModal.tsx --ext .js,.jsx,.ts,.tsx",
    "lint:all": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "type-check": "tsc --noEmit -p tsconfig.release.json",
    "type-check:all": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "jest",
    "android": "EXPO_NO_DOCTOR=1 npx expo start --android",
    "ios": "EXPO_NO_DOCTOR=1 npx expo start --ios",
    "web": "EXPO_NO_DOCTOR=1 npx expo start --web",
    "web:desktop": "bash scripts/start-web-desktop.sh",
    "web:desktop:clear": "bash scripts/start-web-desktop.sh --clear",
    "build:web": "expo export -p web",
    "dev:stop": "pkill -f '[e]xpo start' 2>/dev/null || true; pkill -f '[m]etro' 2>/dev/null || true; echo 'Expo/Metro stop sent (if running).'",
    "metro:clean": "bash scripts/metro-clean.sh"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^1.2.0",
    "@clerk/clerk-react": "5.2.9",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/saira": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-community/slider": "^5.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@react-pdf/renderer": "^4.3.1",
    "ajv": "^8.17.1",
    "buffer": "^6.0.3",
    "dotenv": "^17.2.3",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-av": "^16.0.8",
    "expo-battery": "~10.0.8",
    "expo-blur": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.16",
    "expo-font": "^14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-web-browser": "~15.0.11",
    "i18next": "^25.7.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.3",
    "react-native": "^0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-gifted-charts": "^1.4.64",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "^1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "yoga-layout-prebuilt": "^1.10.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "eslint": "^8.0.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.17",
    "prettier": "^3.0.0",
    "typescript": "^5.1.3"
  },
  "overrides": {
    "react-native-safe-area-context": "~5.6.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(expo|expo-.*|react-native|@react-native|@react-navigation|@expo|expo-router|@react-native-community|react-native-.*|@react-native-.*)/)"
    ]
  }
}
