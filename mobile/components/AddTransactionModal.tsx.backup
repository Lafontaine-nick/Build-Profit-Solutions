    borderWidth: 1,
    borderColor: "rgba(34, 197, 94, 0.3)",
  },
  cancelButtonText: {
    color: "rgba(255,255,255,0.8)",
    fontSize: 15,
    fontWeight: "600",
  },
  saveButton: {
    flex: 1,
    backgroundColor: "#22c55e",
    shadowColor: '#22c55e',
    shadowOffset: { width: 0, height: 6 },
