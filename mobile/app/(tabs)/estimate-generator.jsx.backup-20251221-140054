                    Per Square Foot
                  </Text>
                </TouchableOpacity>
              </View>
            </View>
            
            <ScrollView style={{ flex: 1 }} showsVerticalScrollIndicator={false}>
              <View style={{ padding: 16 }}>
                {/* Labor Summary */}
                {laborItems.length > 0 && (
                  <View style={{ marginBottom: 20 }}>
                    <Text style={{ color: Colors.text, fontSize: 16, fontWeight: '700', marginBottom: 12 }}>
                      Labor Items ({laborItems.length})
                    </Text>
                    
                    {laborItems.map((item, index) => (
                      <TouchableOpacity
                        key={item.id || index}
                        style={[s.stepCard, { marginBottom: 12 }]}
                        onPress={() => setLaborModal({ visible: true, item })}
                      >
                        <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: 8 }}>
                          <View style={{ flex: 1 }}>
                            <View style={{ flexDirection: 'row', alignItems: 'center', marginBottom: 4 }}>
                              <Text style={{ color: Colors.text, fontSize: 16, fontWeight: '600' }}>
                                {item.description || item.name || 'Labor'}
                              </Text>
                              {item.laborType === 'subcontractor' && (
                                <View style={{
                                  marginLeft: 8,
                                  paddingHorizontal: 8,
                                  paddingVertical: 2,
                                  borderRadius: 8,
                                  backgroundColor: 'rgba(245, 158, 11, 0.2)',
                                  borderWidth: 1,
                                  borderColor: '#f59e0b',
                                }}>
                                  <Text style={{ color: '#f59e0b', fontSize: 10, fontWeight: '600' }}>
                                    SUB
                                  </Text>
                                </View>
                              )}
                              {item.laborType === 'inhouse' && (
                                <View style={{
                                  marginLeft: 8,
                                  paddingHorizontal: 8,
                                  paddingVertical: 2,
                                  borderRadius: 8,
                                  backgroundColor: 'rgba(34, 197, 94, 0.2)',
                                  borderWidth: 1,
                                  borderColor: '#22c55e',
                                }}>
                                  <Text style={{ color: '#22c55e', fontSize: 10, fontWeight: '600' }}>
                                    IN-HOUSE
                                  </Text>
                                </View>
                              )}
                            </View>
                            <Text style={{ color: Colors.sub, fontSize: 12, marginTop: 4 }}>
                              {item.mode === 'sqft' ? (
                                `${bid.sqft || 0} sqft × ${money(item.rate || 0)}/sqft`
                              ) : (
                                `${item.hours || 0} hrs × ${money(item.rate || 0)}/hr`
                              )}
                            </Text>
                            {item.metadata && (
                              <View style={{ marginTop: 4 }}>
                                {item.metadata.rating && (
                                  <Text style={{ color: Colors.sub, fontSize: 11 }}>
                                    ⭐ {item.metadata.rating} ({item.metadata.reviews || 0} reviews)
                                  </Text>
                                )}
                                {item.metadata.location && (
                                  <Text style={{ color: Colors.sub, fontSize: 11 }}>
                                    📍 {item.metadata.location}
                                  </Text>
                                )}
                              </View>
                            )}
                          </View>
                          <View style={{ alignItems: 'flex-end' }}>
                            <Text style={{ color: Colors.text, fontSize: 18, fontWeight: '700' }}>
                              {money(item.total || 0)}
                            </Text>
                            <TouchableOpacity
                              style={{ marginTop: 8 }}
                              onPress={() => {
                                Alert.alert(
                                  'Delete Labor Item?',
                                  `Remove "${item.description || item.name || 'Labor'}"?`,
                                  [
                                    { text: 'Cancel', style: 'cancel' },
                                    {
                                      text: 'Delete',
                                      style: 'destructive',
                                      onPress: () => {
                                        const updated = laborItems.filter(l => l.id !== item.id);
                                        updateBid('laborLineItems', updated);
                                        Haptics.impactAsync(Haptics.ImpactFeedbackStyle.Medium);
                                      }
                                    }
                                  ]
                                );
                              }}
                            >
                              <Ionicons name="trash-outline" size={18} color={Colors.sub} />
                            </TouchableOpacity>
                          </View>
                        </View>
                      </TouchableOpacity>
                    ))}
                    
                    <View style={{
                      backgroundColor: 'rgba(34, 197, 94, 0.1)',
                      borderRadius: 12,
                      padding: 16,
                      borderWidth: 1,
                      borderColor: 'rgba(34, 197, 94, 0.3)',
                    }}>
                      <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
                        <Text style={{ color: Colors.text, fontSize: 16, fontWeight: '700' }}>
                          Total Labor:
                        </Text>
                        <Text style={{ color: '#22c55e', fontSize: 20, fontWeight: '700' }}>
                          {money(totalLabor)}
                        </Text>
                      </View>
                    </View>
                  </View>
                )}
                
                {/* Empty State */}
                {laborItems.length === 0 && (
                  <View style={{ alignItems: 'center', paddingVertical: 60 }}>
                    <Ionicons name="people-outline" size={80} color={Colors.sub} />
                    <Text style={{ color: Colors.text, fontSize: 18, fontWeight: '600', marginTop: 16, marginBottom: 8 }}>
                      No Labor Items Yet
                    </Text>
                    <Text style={{ color: Colors.sub, fontSize: 14, textAlign: 'center', marginBottom: 24 }}>
                      Add in-house labor or search for subcontractors to get started
                    </Text>
                  </View>
                )}
              </View>
            </ScrollView>
            
            {/* Subcontractor Search Modal */}
            <SubcontractorSearchModal
              visible={subcontractorModalVisible}
              onClose={() => setSubcontractorModalVisible(false)}
              onSelect={handleSubcontractorSelect}
              defaultZip={bid.customerZip || ''}
            />
          </View>
        );
      }
      
      case 6: {
        return (
          <ScrollView style={{ flex: 1 }} showsVerticalScrollIndicator={false}>
            <View style={{ padding: 16 }}>
              <View style={s.inputGroup}>
                <Text style={s.label}>Insurance Overhead</Text>
                <TextInput
                  style={s.input}
                  placeholder="0"
                  placeholderTextColor={Colors.sub}
                  value={bid.insuranceOverhead?.toString() || ''}
                  onChangeText={(text) => updateBid('insuranceOverhead', parseFloat(text) || 0)}
                  keyboardType="decimal-pad"
                />
              </View>
              
              <View style={s.inputGroup}>
                <Text style={s.label}>Equipment</Text>
                <TextInput
                  style={s.input}
                  placeholder="0"
                  placeholderTextColor={Colors.sub}
                  value={bid.equipment?.toString() || ''}
                  onChangeText={(text) => updateBid('equipment', parseFloat(text) || 0)}
                  keyboardType="decimal-pad"
                />
              </View>
              
              <View style={s.inputGroup}>
                <Text style={s.label}>Facilities</Text>
                <TextInput
                  style={s.input}
                  placeholder="0"
                  placeholderTextColor={Colors.sub}
                  value={bid.facilities?.toString() || ''}
                  onChangeText={(text) => updateBid('facilities', parseFloat(text) || 0)}
                  keyboardType="decimal-pad"
                />
              </View>
              
              <View style={s.inputGroup}>
                <Text style={s.label}>Other Overhead</Text>
                <TextInput
                  style={s.input}
                  placeholder="0"
                  placeholderTextColor={Colors.sub}
                  value={bid.otherOverhead?.toString() || ''}
                  onChangeText={(text) => updateBid('otherOverhead', parseFloat(text) || 0)}
                  keyboardType="decimal-pad"
                />
              </View>
              
              <View style={s.inputGroup}>
                <Text style={s.label}>Markup Percentage</Text>
                <TextInput
                  style={s.input}
                  placeholder="15"
                  placeholderTextColor={Colors.sub}
                  value={bid.markupPct?.toString() || ''}
                  onChangeText={(text) => updateBid('markupPct', parseFloat(text) || 0)}
                  keyboardType="decimal-pad"
                />
                <Text style={{ color: Colors.sub, fontSize: 12, marginTop: 4 }}>
                  Current markup: {money(calc.profit)} ({bid.markupPct || 0}%)
                </Text>
              </View>
            </View>
          </ScrollView>
        );
      }
      
      case 7: {
        return (
          <ProjectAnalysis
            bid={bid}
            calc={calc}
            materialsCart={materialsCart}
            laborLineItems={bid.laborLineItems || []}
          />
        );
      }
      
      case 8: {
        return (
          <ScrollView style={{ flex: 1 }} showsVerticalScrollIndicator={false}>
            <View style={{ padding: 16 }}>
              <View style={s.inputGroup}>
                <Text style={s.label}>Payment Schedule Type</Text>
                <View style={{ flexDirection: 'row', marginBottom: 16 }}>
                  <TouchableOpacity
                    style={[s.chip, (bid.paymentSchedule || 'milestone-based') === 'milestone-based' && s.chipActive]}
                    onPress={() => {
                      updateBid('paymentSchedule', 'milestone-based');
                    }}
                  >
                    <Text style={[s.chipText, (bid.paymentSchedule || 'milestone-based') === 'milestone-based' && { color: '#fff' }]}>
                      Milestone-Based
                    </Text>
                  </TouchableOpacity>
                  <TouchableOpacity
                    style={[s.chip, bid.paymentSchedule === 'weekly' && s.chipActive]}
                    onPress={() => {
                      updateBid('paymentSchedule', 'weekly');
                    }}
                  >
                    <Text style={[s.chipText, bid.paymentSchedule === 'weekly' && { color: '#fff' }]}>
                      Weekly
                    </Text>
                  </TouchableOpacity>
                </View>
              </View>
              
              {(bid.paymentSchedule || 'milestone-based') === 'milestone-based' ? (
                <View>
                  <Text style={[s.label, { marginBottom: 12 }]}>Payment Milestones</Text>
                  {(bid.paymentMilestones || []).map((milestone, index) => (
                    <View key={milestone.id || index} style={[s.stepCard, { marginBottom: 12 }]}>
                      <Text style={{ color: Colors.text, fontSize: 16, fontWeight: '600', marginBottom: 8 }}>
                        {milestone.name || `Milestone ${index + 1}`}
                      </Text>
                      <View style={{ flexDirection: 'row', justifyContent: 'space-between', marginBottom: 8 }}>
                        <Text style={{ color: Colors.sub, fontSize: 12 }}>Amount: {money(milestone.paymentAmount || 0)}</Text>
                        <Text style={{ color: Colors.sub, fontSize: 12 }}>Percentage: {milestone.percentage || 0}%</Text>
                      </View>
                      {milestone.scheduledDate && (
                        <Text style={{ color: Colors.sub, fontSize: 12 }}>
                          Date: {milestone.scheduledDate}
                        </Text>
                      )}
                    </View>
                  ))}
                </View>
              ) : (
                <View>
                  <Text style={[s.label, { marginBottom: 12 }]}>Weekly Payments</Text>
                  {(bid.weeklyPayments || []).map((payment, index) => (
                    <View key={payment.id || index} style={[s.stepCard, { marginBottom: 12 }]}>
                      <Text style={{ color: Colors.text, fontSize: 16, fontWeight: '600', marginBottom: 8 }}>
                        {payment.description || `Week ${payment.weekNumber || index + 1}`}
                      </Text>
                      <View style={{ flexDirection: 'row', justifyContent: 'space-between', marginBottom: 8 }}>
                        <Text style={{ color: Colors.sub, fontSize: 12 }}>Amount: {money(payment.amount || 0)}</Text>
                        <Text style={{ color: Colors.sub, fontSize: 12 }}>Percentage: {payment.percentage || 0}%</Text>
                      </View>
                      {payment.scheduledDate && (
                        <Text style={{ color: Colors.sub, fontSize: 12 }}>
                          Payment Date: {payment.scheduledDate}
                        </Text>
                      )}
                    </View>
                  ))}
                </View>
              )}
            </View>
          </ScrollView>
        );
      }
      
      case 9: {
        return (
          <ScrollView style={{ flex: 1 }} showsVerticalScrollIndicator={false}>
            <View style={{ padding: 16 }}>
              <View style={s.inputGroup}>
                <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
                  <Text style={s.label}>License Required</Text>
                  <Switch
                    value={bid.license || false}
                    onValueChange={(value) => updateBid('license', value)}
                    trackColor={{ false: Colors.line, true: Colors.primary }}
                    thumbColor={bid.license ? '#fff' : Colors.sub}
                  />
                </View>
              </View>
              
              <View style={s.inputGroup}>
                <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
                  <Text style={s.label}>Insurance Required</Text>
                  <Switch
                    value={bid.insurance || false}
                    onValueChange={(value) => updateBid('insurance', value)}
                    trackColor={{ false: Colors.line, true: Colors.primary }}
                    thumbColor={bid.insurance ? '#fff' : Colors.sub}
                  />
                </View>
              </View>
              
              <View style={s.inputGroup}>
                <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
                  <Text style={s.label}>Bond Required</Text>
                  <Switch
                    value={bid.bond || false}
                    onValueChange={(value) => updateBid('bond', value)}
                    trackColor={{ false: Colors.line, true: Colors.primary }}
                    thumbColor={bid.bond ? '#fff' : Colors.sub}
                  />
                </View>
              </View>
              
              <View style={s.inputGroup}>
                <View style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', marginBottom: 12 }}>
                  <Text style={s.label}>OSHA Compliance</Text>
                  <Switch
                    value={bid.osha || false}
                    onValueChange={(value) => updateBid('osha', value)}
                    trackColor={{ false: Colors.line, true: Colors.primary }}
                    thumbColor={bid.osha ? '#fff' : Colors.sub}
                  />
                </View>
              </View>
            </View>
          </ScrollView>
        );
      }
      
      case 10: {
        const aiLevel = healthScore >= 75 ? 'good' : healthScore >= 55 ? 'warn' : 'risk';
        
        return (
          <ScrollView style={{ flex: 1 }} showsVerticalScrollIndicator={false}>
            <View style={{ padding: 16 }}>
              <LinearGradient
                colors={["rgba(34, 197, 94, 0.15)", "rgba(34, 211, 238, 0.08)", "rgba(34, 197, 94, 0)"]}
                start={{ x: 0, y: 0 }}
                end={{ x: 1, y: 1 }}
                style={{
                  borderRadius: 20,
                  padding: 20,
                  marginBottom: 16,
                  borderWidth: 1,
                  borderColor: 'rgba(34, 197, 94, 0.3)',
                  alignItems: 'center',
                }}
              >
                <Text style={{ color: Colors.sub, fontSize: 12, marginBottom: 8, fontWeight: '600', letterSpacing: 1 }}>
                  HEALTH SCORE
                </Text>
                <Text style={{ color: healthColor, fontSize: 48, fontWeight: '700', marginBottom: 8 }}>
                  {healthScore}
                </Text>
                <Text style={{ color: Colors.sub, fontSize: 14 }}>
                  {aiLevel === 'good' ? 'Ready to send' : aiLevel === 'warn' ? 'Review recommended' : 'Needs attention'}
                </Text>
              </LinearGradient>
              
              <TouchableOpacity
                style={{
                  backgroundColor: Colors.primary,
                  borderRadius: 12,
                  padding: 16,
                  alignItems: 'center',
                  marginBottom: 16,
                }}
                onPress={generateContract}
              >
                <Text style={{ color: '#fff', fontSize: 16, fontWeight: '700' }}>
                  Generate & Export Contract
                </Text>
              </TouchableOpacity>
              
              <TouchableOpacity
                style={s.outlineBtn}
                onPress={handleSaveEstimate}
              >
                <Text style={s.outlineBtnText}>Save Bid</Text>
              </TouchableOpacity>
            </View>
          </ScrollView>
        );
      }
      
      default:
        return null;
    }
  };

  return (
    <SafeAreaView style={s.container} edges={['top']}>
      <StatusBar barStyle="light-content" />
      
      {/* Header */}
      <View style={{
        flexDirection: 'row',
        justifyContent: 'space-between',
        alignItems: 'center',
        paddingHorizontal: 16,
        paddingVertical: 12,
        borderBottomWidth: 1,
        borderBottomColor: Colors.line,
      }}>
        <TouchableOpacity
          onPress={() => router.back()}
          style={{ padding: 8 }}
        >
          <Ionicons name="arrow-back" size={24} color={Colors.text} />
        </TouchableOpacity>
        
        <TouchableOpacity
          onPress={() => setShowCostBreakdownModal(true)}
          style={{ flex: 1, alignItems: 'center' }}
        >
          <Text style={{ color: Colors.text, fontSize: 16, fontWeight: '600' }}>
            View Summary
          </Text>
        </TouchableOpacity>
        
        <TouchableOpacity
          onPress={() => {
            if (step < 10) {
              setStep(step + 1);
            }
          }}
          style={{
            backgroundColor: Colors.primary,
            paddingHorizontal: 16,
            paddingVertical: 8,
            borderRadius: 8,
          }}
        >
          <Text style={{ color: '#fff', fontSize: 14, fontWeight: '600' }}>
            Next →
          </Text>
        </TouchableOpacity>
      </View>
      
      {/* Step Indicator */}
      <View style={{
        flexDirection: 'row',
        justifyContent: 'space-between',
        paddingHorizontal: 16,
        paddingVertical: 12,
        borderBottomWidth: 1,
        borderBottomColor: Colors.line,
      }}>
        {STEPS.map((s, index) => (
          <TouchableOpacity
            key={s.id}
            onPress={() => setStep(s.id)}
            style={{
              flex: 1,
              alignItems: 'center',
              paddingVertical: 8,
              borderBottomWidth: step === s.id ? 2 : 0,
              borderBottomColor: Colors.primary,
            }}
          >
            <Ionicons
              name={getStepIcon(s.id)}
              size={20}
              color={step === s.id ? Colors.primary : Colors.sub}
            />
            <Text style={{
              color: step === s.id ? Colors.primary : Colors.sub,
              fontSize: 10,
              marginTop: 4,
            }}>
              {s.id}
            </Text>
          </TouchableOpacity>
        ))}
      </View>
      
      {/* Step Content */}
      {renderStepContent()}
      
      {/* Modals */}
      <LineItemModal
        visible={materialModal.visible}
        onClose={() => setMaterialModal({ visible: false, item: null })}
        item={materialModal.item}
        onSave={(item) => {
          if (materialModal.item) {
            setMaterialsCart(prev => prev.map(m => m.id === materialModal.item.id ? item : m));
          } else {
            setMaterialsCart(prev => [...prev, { ...item, id: Date.now().toString() }]);
          }
          setMaterialModal({ visible: false, item: null });
        }}
        title="Material"
        laborMode={false}
      />
      
      <LineItemModal
        visible={laborModal.visible}
        onClose={() => setLaborModal({ visible: false, item: null })}
        item={laborModal.item}
        onSave={(item) => {
          const updated = bid.laborLineItems || [];
          if (laborModal.item) {
            const index = updated.findIndex(l => l.id === laborModal.item.id);
            if (index >= 0) {
              updated[index] = item;
            }
          } else {
            updated.push({ ...item, id: Date.now().toString() });
          }
          updateBid('laborLineItems', updated);
          setLaborModal({ visible: false, item: null });
        }}
        title="Labor"
        laborMode={true}
      />
    </SafeAreaView>
  );
}