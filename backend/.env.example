# Workspace invite email delivery
# Supported values: resend, sendgrid
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SENDGRID_API_KEY=
WORKSPACE_INVITE_FROM_EMAIL=
WORKSPACE_INVITE_FROM_NAME=Build Profit Solutions
WORKSPACE_INVITE_URL=https://buildprofitsolutions.com

# OpenAI estimate shadow evaluation. Keep live shadow disabled until explicitly
# enabled for a controlled canary; BPS pricing remains authoritative.
OPENAI_API_KEY=
AI_ESTIMATE_SHADOW_ENABLED=false
AI_ESTIMATE_SHADOW_LIVE_ENABLED=false
