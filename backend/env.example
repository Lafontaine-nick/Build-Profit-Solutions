# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8081

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (for future use)
# DATABASE_URL=your_database_url_here

# Security
JWT_SECRET=your_jwt_secret_here
# Dev/ops only: allow POST /api/unified-leads/reload (requires valid Bearer token)
# ALLOW_UNIFIED_LEADS_RELOAD=true

# Legacy demo lead APIs (bid-invitations, shared-leads). Default off — not part of the three product lead paths.
# ENABLE_LEGACY_LEAD_APIS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# Local dev: use 5000+ or set DISABLE_API_RATE_LIMIT=true. Values under 2000 are bumped to 5000 in
# non-production unless RATE_LIMIT_STRICT_DEV=true (avoids 429 on Find Subcontractors + SPA).
RATE_LIMIT_MAX_REQUESTS=5000
# DISABLE_API_RATE_LIMIT=true
# RATE_LIMIT_STRICT_DEV=true
# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs (will be generated when you run setup-stripe.js)
STRIPE_PRICE_BASIC=price_basic_monthly
STRIPE_PRICE_PREMIUM=price_premium_monthly
# Optional: Professional plan — use Product ID so the Dashboard "Default" price ($89) is used (avoids stale price_ ids)
# STRIPE_PRODUCT_PROFESSIONAL=prod_xxxxxxxxxxxxx
# Business / third tier (mobile plan catalog + checkout)
STRIPE_PRICE_BUSINESS=price_business_monthly

# SKU Search APIs (for real Home Depot/Lowes pricing)
# Option 1: WebScrapingAPI (https://www.webscrapingapi.com/) - Free tier: 1000 requests/month
WEBSCRAPINGAPI_KEY=YOUR_WEBSCRAPINGAPI_KEY_HERE

# Option 2: SerpAPI (https://serpapi.com/) - Free tier: 100 searches/month
SERPAPI_KEY=YOUR_SERPAPI_KEY_HERE

# Yelp Fusion API (for contractor/supplier search)
# Sign up: https://www.yelp.com/developers/v3/manage_app
# Free tier: 5000 API calls/day
YELP_API_KEY=YOUR_YELP_API_KEY_HERE

# Twilio Configuration (for SMS messaging to team members)
# Sign up: https://www.twilio.com/try-twilio
# Free tier: $15.50 credit, ~1000 SMS messages
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Beta feedback (contractor beta) — run database/beta_feedback.sql on Postgres first
BETA_FEEDBACK_INTAKE_ENABLED=false
BETA_FEEDBACK_ADMIN_KEY=generate_a_long_random_secret_for_review_api
# Lightweight product events (estimate_created, feedback_submitted, etc.)
APP_TELEMETRY_ENABLED=false

# Google Maps Platform — same key for Places API (New), Geocoding, etc. Required for Find Subcontractors on THIS server.
# Without it, /api/places/contractors/search returns metadata.disabled locally; production Render needs this in the dashboard env.
GOOGLE_PLACES_API_KEY=
# Alias supported by code — use one:
# GOOGLE_MAPS_API_KEY=
