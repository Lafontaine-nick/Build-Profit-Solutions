{
  "name": "build-profit-solutions-backend",
  "version": "1.0.0",
  "description": "Backend API for Build Profit Solutions lead generation system",
  "main": "src/server.js",
  "scripts": {
    "setup:env": "node scripts/setup-local-env.js",
    "setup:env:simple": "node scripts/setup-simple-env.js",
    "start": "node src/server.js",
    "start:render": "node scripts/ensure-puppeteer-chrome-on-render-start.js && node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:ai": "jest --runInBand src/config/__tests__/aiConfig.test.js src/services/__tests__/aiAssistantCore.test.js src/services/__tests__/aiDashboardService.test.js src/services/__tests__/leadScoring.test.js src/routes/__tests__/promptSystem.test.js src/routes/__tests__/ocr.test.js",
    "test:ai:watch": "jest --watch --runInBand src/config/__tests__/aiConfig.test.js src/services/__tests__/aiAssistantCore.test.js src/services/__tests__/aiDashboardService.test.js src/services/__tests__/leadScoring.test.js src/routes/__tests__/promptSystem.test.js src/routes/__tests__/ocr.test.js",
    "test:eval": "jest --runInBand src/services/__tests__/estimateEvalHarness.test.js src/services/__tests__/scopeGoldenNotesCorpus.test.js",
    "smoke:closeout": "node scripts/smoke-closeout-calibration.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "echo 'No build step required for Node.js'",
    "postinstall": "echo 'Backend dependencies installed successfully' && node scripts/ensure-puppeteer-chrome.js",
    "install-chrome:render-build": "node scripts/install-puppeteer-chrome-render-build.js",
    "verify-sku": "node verify-sku-search.js",
    "verify-ai-core": "node verify-ai-assistant-core.js",
    "verify:ai": "node verify-ai-assistant-core.js && node scripts/verify-ai-contracts.js",
    "verify:ai:live": "LIVE_AI_SMOKE=true node scripts/verify-ai-live.js",
    "migrate:beta-feedback": "node scripts/run-beta-feedback-migration.js",
    "check:beta-review": "node scripts/check-beta-review.js"
  },
  "dependencies": {
    "@clerk/backend": "^1.29.0",
    "@puppeteer/browsers": "2.13.0",
    "@sparticuz/chromium": "^148.0.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "heic-convert": "^2.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "openai": "^4.20.1",
    "pg": "^8.11.3",
    "puppeteer": "^24.40.0",
    "puppeteer-core": "^24.40.0",
    "stripe": "^14.7.0",
    "twilio": "^5.12.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "qrcode-terminal": "^0.12.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "puppeteer": {
    "skipDownload": true
  },
  "keywords": [
    "express",
    "api",
    "lead-generation",
    "construction",
    "openai"
  ],
  "author": "Build Profit Solutions",
  "license": "MIT"
}
