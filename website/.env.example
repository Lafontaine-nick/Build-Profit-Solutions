# Public marketing site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://buildprofitsolutions.com

# Web app sign-in / sign-up destination (no trailing slash)
NEXT_PUBLIC_WEB_APP_URL=https://app.buildprofitsolutions.com

# App store links — use #download until listings are live
NEXT_PUBLIC_IOS_APP_URL=#download
NEXT_PUBLIC_ANDROID_APP_URL=#download

NEXT_PUBLIC_CONTACT_EMAIL=support@buildprofitsolutions.com
NEXT_PUBLIC_FOUNDER_NAME=Nicholas Lafontaine

# Pre-launch: hides sign-up, web app, and purchase CTAs. Set to false when ready to launch.
NEXT_PUBLIC_PRELAUNCH=true
